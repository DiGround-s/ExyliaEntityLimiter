[CENTER][SIZE=5][B][COLOR=#8a51c4]📝 Commands[/COLOR][/B][/SIZE][/CENTER]

[CODE]
/entitylimiter reload      - Reload configuration
/entitylimiter stats       - View cache statistics
/entitylimiter cleanup     - Manually cleanup current chunk
/entitylimiter info        - View current chunk entity information
/entitylimiter list [page] - List all loaded chunks sorted by priority
/entitylimiter teleport <world> <x> <z> - Teleport to specific chunk
/entitylimiter alert       - Toggle entity removal notifications
[/CODE]

[CENTER][SIZE=5][B][COLOR=#8a51c4]🔐 Permissions[/COLOR][/B][/SIZE][/CENTER]

[CODE]
entitylimiter.*         - All permissions
entitylimiter.reload    - Reload configuration
entitylimiter.stats     - View statistics
entitylimiter.cleanup   - Manual cleanup
entitylimiter.info      - View chunk info
entitylimiter.list      - List chunks
entitylimiter.teleport  - Teleport to chunks
entitylimiter.alert     - Toggle alerts
[/CODE]

[CENTER][SIZE=5][B][COLOR=#8a51c4]⚙️ Configuration[/COLOR][/B][/SIZE][/CENTER]

[SPOILER="Example Configuration"]
[CODE]
entity-limiter:
  cleanup-interval: 100  # ticks (5 seconds)
  debug: false
  removal-strategy: FARTHEST_FROM_PLAYERS  # FARTHEST_FROM_PLAYERS, RANDOM, OLDEST
  particle:
    enabled: true
    type: SMOKE
    count: 10
  bypass:
    custom-named: true
    villagers-with-profession: true
    bypass-tagged-entities: true

limits:
  ZOMBIE: 10
  SKELETON: 10
  CREEPER: 8
  SPIDER: 10
  ENDERMAN: 5
  ITEM: 50
  DROPPED_ITEM: 50
  default: -1  # -1 = no limit
[/CODE]
[/SPOILER]

[CENTER][SIZE=5][B][COLOR=#8a51c4]🎯 Removal Strategies[/COLOR][/B][/SIZE][/CENTER]

[B][COLOR=#59a4ff]FARTHEST_FROM_PLAYERS[/COLOR][/B] [COLOR=#b9a5cc](Recommended)[/COLOR]
[COLOR=#e7cfff]Removes entities farthest from players first, minimizing player impact.[/COLOR]

[B][COLOR=#59a4ff]RANDOM[/COLOR][/B]
[COLOR=#e7cfff]Randomly removes entities for balanced distribution.[/COLOR]

[B][COLOR=#59a4ff]OLDEST[/COLOR][/B]
[COLOR=#e7cfff]Removes oldest entities first, keeping newer spawns alive.[/COLOR]

[CENTER][SIZE=5][B][COLOR=#8a51c4]📊 API for Developers[/COLOR][/B][/SIZE][/CENTER]

[COLOR=#e7cfff]Exylia Entity Limiter provides a comprehensive API for developers:[/COLOR]

[CODE]
EntityLimiterAPI api = (EntityLimiterAPI) Bukkit.getPluginManager().getPlugin("ExyliaEntityLimiter");

// Check chunk limits
api.checkChunkLimits(chunk).thenAccept(result -> {
    if (result.hasExceeded()) {
        // Handle exceeded limits
    }
});

// Get entity counts
api.getEntityCount(chunk).thenAccept(counts -> {
    // Process entity counts
});

// Listen to events
@EventHandler
public void onEntityRemoved(EntityRemovedEvent event) {
    Chunk chunk = event.getChunk();
    List<Entity> removed = event.getEntities();
    // Handle entity removal
}
[/CODE]

